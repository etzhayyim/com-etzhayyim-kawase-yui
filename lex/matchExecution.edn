{"lexicon" 1,
 "id" "com.etzhayyim.kawase.matchExecution",
 "description"
 "Settlement evidence per ADR-2608011200. Records counter-intent, reserve-buffer or bounded-AMM execution. bounded-amm records MUST include adapter/codehash, fee, oracle/execution rate, price-impact, min-out and deadline fields so LP compensation, protocol revenue and slippage remain independently auditable.",
 "defs"
 {"main"
  {"type" "record",
   "key" "tid",
   "record"
   {"type" "object",
    "required"
    ["v"
     "matchEpoch"
     "settlementMode"
     "srcIntentCid"
     "srcStable"
     "tgtStable"
     "srcAmountMinor"
     "tgtAmountMinor"
     "fxRateBps"
     "fxRateAttestationCid"
     "mKotoDebitAmount"
     "executedAt"],
    "properties"
    {"settlementMode"
     {"type" "string",
      "enum" ["matched" "reserve-disbursed" "bounded-amm"],
      "description"
      "matched = counter intent; reserve-disbursed = reserve buffer; bounded-amm = approved stable-pair AMM adapter under ADR-2608011200."},
     "ammAdapter" {"type" "string"},
     "adapterCodehash" {"type" "string"},
     "hookCodehash" {"type" "string"},
     "lpFeeBps" {"type" "integer", "minimum" 0, "maximum" 30},
     "protocolFeeBps" {"type" "integer", "minimum" 0, "maximum" 5},
     "oracleContract" {"type" "string"},
     "oracleCodehash" {"type" "string"},
     "oracleRateBps" {"type" "integer", "minimum" 1},
     "oracleObservedAt" {"type" "string", "format" "datetime"},
     "sequencerUptimeFeed" {"type" "string"},
     "executionRateBps" {"type" "integer", "minimum" 1},
     "priceImpactBps" {"type" "integer", "minimum" 0, "maximum" 50},
     "minAmountOutMinor" {"type" "integer", "minimum" 1},
     "deadline" {"type" "string", "format" "datetime"},
     "executingCellDid"
     {"type" "string",
      "format" "did",
      "description"
      "DID of the Murakumo fleet node that executed this match cell tick. MUST be a fleet.toml-listed node per G12 + ADR-2605215000."},
     "fxRateBps"
     {"type" "integer",
      "minimum" 1,
      "description"
      "Rate locked at depositAttestation creation. MUST be identical to depositAttestation.fxRateBps."},
     "mKotoDebitAmount"
     {"type" "integer",
      "minimum" 0,
      "description"
      "mKOTO debited from operator DID balance per ADR-2605282100 for this match cell tick. Royalty pool credit emitted symmetrically."},
     "matchEpoch"
     {"type" "integer",
      "minimum" 0,
      "description"
      "Pregel cell epoch number at which the match was executed."},
     "tgtAmountMinor" {"type" "integer", "minimum" 1},
     "v" {"type" "integer", "minimum" 1, "maximum" 1},
     "srcIntentCid"
     {"type" "string",
      "description"
      "depositAttestation.intentCid of the originating deposit."},
     "tgtStable"
     {"type" "string",
      "enum" ["USDC" "EURC" "JPYC" "KRWO" "GBPe" "CHFe"]},
     "fxRateAttestationCid" {"type" "string"},
     "srcStable"
     {"type" "string",
      "enum" ["USDC" "EURC" "JPYC" "KRWO" "GBPe" "CHFe"]},
     "executedAt" {"type" "string", "format" "datetime"},
     "srcAmountMinor" {"type" "integer", "minimum" 1},
     "tgtIntentCid"
     {"type" "string",
      "description"
      "withdrawIntent.intentCid of the matched counter-intent. ABSENT when settlementMode = reserve-disbursed."}}}}}}
